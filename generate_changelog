# This script updates the CHANGELOG.md using git-cliff
# and generates diff changelog with latest changes to use in release notes

set -e

# Check if git-cliff installed
if ! command -v git-cliff &> /dev/null
then
  echo "git-cliff tool could not be found. Install 'git-cliff' first."
  exit 1
fi

# Check version number parameter
version_number=$1
if [ -z "${version_number}" ]
then
 echo >&2 "Missing version number parameter"
 exit 1
fi

# The release tag is cut after this script runs, so the version is rendered as
# the tag for the commits that do not belong to a tag yet.
cliff_args="--tag ${version_number} --unreleased"

# Generate the entry for the new version on its own, without the changelog header
git-cliff $cliff_args --strip header --output release_notes.md

# Drop the version heading and the blank line below it
tail -n +3 release_notes.md > release_notes_sections.md
mv release_notes_sections.md release_notes.md

# Update changelog
git-cliff $cliff_args --prepend CHANGELOG.md
